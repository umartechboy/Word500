<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Word500.KeyboardKey">

    <Border x:Name="tileBorder" HorizontalOptions="Fill" Margin="2,0">
        <Border.GestureRecognizers>
            <PointerGestureRecognizer PointerPressed="PointerGestureRecognizer_PointerPressed"  PointerReleased="PointerGestureRecognizer_PointerReleased" />
        </Border.GestureRecognizers>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="5"></RoundRectangle>
        </Border.StrokeShape>
        <Label HorizontalTextAlignment="Center" VerticalTextAlignment="Center" x:Name="text"></Label>
    </Border>
</ContentView>
