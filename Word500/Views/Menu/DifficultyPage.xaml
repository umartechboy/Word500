<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Word500.DifficultyPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource White}">

    <Grid RowDefinitions="*,Auto" Padding="30,40">
        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center"
                             MaximumWidthRequest="420" HorizontalOptions="Center"
                             Spacing="0">

            <!-- Icon -->
            <Border WidthRequest="88" HeightRequest="88"
                    StrokeThickness="0" HorizontalOptions="Center"
                    Margin="0,0,0,20"
                    x:Name="iconBadge" BackgroundColor="#EDE7FB">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Image Source="icon_difficulty.png" WidthRequest="52" HeightRequest="52"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Difficulty Name -->
            <Label x:Name="lblDifficultyName"
                   Text="Regular"
                   FontSize="32" FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource Primary}"
                   Margin="0,0,0,4" />

            <!-- Emoji row -->
            <Label x:Name="lblStars"
                   Text="&#x2B50;&#x2B50;&#x2B50;"
                   FontSize="22"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,24" />

            <!-- Slider -->
            <Border Stroke="{StaticResource Gray100}" StrokeThickness="1"
                    BackgroundColor="#FAFAFA" Padding="24,20"
                    HorizontalOptions="Fill" Margin="0,0,0,24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,4">
                        <Label Grid.Column="0" Text="Childish" FontSize="11"
                               TextColor="{StaticResource Gray400}" HorizontalTextAlignment="Start" />
                        <Label Grid.Column="1" Text="Impossible" FontSize="11"
                               TextColor="{StaticResource Gray400}" HorizontalTextAlignment="End" />
                    </Grid>
                    <Slider x:Name="difficultySlider"
                            Minimum="0" Maximum="4"
                            MinimumTrackColor="{StaticResource Primary}"
                            MaximumTrackColor="{StaticResource Gray200}"
                            ThumbColor="{StaticResource Primary}"
                            ValueChanged="OnSliderChanged"
                            Value="2" />
                </VerticalStackLayout>
            </Border>

            <!-- Stats Card -->
            <Border x:Name="statsCard" Stroke="{StaticResource Gray100}" StrokeThickness="1"
                    BackgroundColor="{StaticResource White}" Padding="20,18"
                    HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <!-- Word Length -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="Word Length"
                               FontSize="15" TextColor="{StaticResource Gray500}"
                               VerticalOptions="Center" />
                        <Label x:Name="lblLetters" Grid.Column="2"
                               Text="5 letters" FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />
                    <!-- Chances -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="Chances"
                               FontSize="15" TextColor="{StaticResource Gray500}"
                               VerticalOptions="Center" />
                        <Label x:Name="lblChances" Grid.Column="2"
                               Text="8 guesses" FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />
                    <!-- Squible -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="Hints"
                               FontSize="15" TextColor="{StaticResource Gray500}"
                               VerticalOptions="Center" />
                        <Label x:Name="lblHints" Grid.Column="2"
                               Text="Unlimited" FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />
                    <!-- Description -->
                    <Label x:Name="lblDescription"
                           Text="The classic experience. A solid challenge for any word lover."
                           FontSize="13" TextColor="{StaticResource Gray400}"
                           HorizontalTextAlignment="Center"
                           Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

        <!-- Begin Button -->
        <Button Grid.Row="1" x:Name="btnBegin"
                Text="BEGIN"
                FontSize="18" FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="{StaticResource Primary}"
                CornerRadius="14"
                HeightRequest="56"
                MaximumWidthRequest="420"
                HorizontalOptions="Fill"
                Margin="0,20,0,10"
                Clicked="OnBeginClicked" />
    </Grid>

</ContentPage>
