<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Word500.CustomGamePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource White}">

    <Grid RowDefinitions="*,Auto" Padding="30,40">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout VerticalOptions="Center"
                                 MaximumWidthRequest="420" HorizontalOptions="Center"
                                 Spacing="0">

                <!-- Icon -->
                <Border WidthRequest="88" HeightRequest="88"
                        StrokeThickness="0" HorizontalOptions="Center"
                        Margin="0,0,0,12" BackgroundColor="#E8E0F7">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Image Source="icon_logic.png" WidthRequest="52" HeightRequest="52"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="Custom Game"
                       FontSize="28" FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Tertiary}"
                       Margin="0,0,0,6" />
                <Label Text="Set your own rules"
                       FontSize="14" HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Gray400}"
                       Margin="0,0,0,32" />

                <!-- Chances -->
                <Border Stroke="{StaticResource Gray100}" StrokeThickness="1"
                        BackgroundColor="#FAFAFA" Padding="20,18"
                        HorizontalOptions="Fill" Margin="0,0,0,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Chances"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource Gray900}" VerticalOptions="Center" />
                            <Label x:Name="lblChancesValue" Grid.Column="1"
                                   Text="8 guesses" FontSize="15"
                                   TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                        <Slider x:Name="chancesSlider"
                                Minimum="3" Maximum="12" Value="8"
                                MinimumTrackColor="{StaticResource Primary}"
                                MaximumTrackColor="{StaticResource Gray200}"
                                ThumbColor="{StaticResource Primary}"
                                ValueChanged="OnChancesChanged" />
                    </VerticalStackLayout>
                </Border>

                <!-- Word Entry -->
                <Border Stroke="{StaticResource Gray100}" StrokeThickness="1"
                        BackgroundColor="#FAFAFA" Padding="20,18"
                        HorizontalOptions="Fill" Margin="0,0,0,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Word"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}" />

                        <!-- Random toggle -->
                        <Grid ColumnDefinitions="*,50" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="Use a random word"
                                   FontSize="14" TextColor="{StaticResource Gray500}"
                                   VerticalOptions="Center" LineBreakMode="NoWrap" />
                            <Switch x:Name="switchRandom"
                                    Grid.Column="1"
                                    IsToggled="True"
                                    OnColor="{StaticResource Primary}"
                                    Toggled="OnRandomToggled"
                                    HorizontalOptions="End" />
                        </Grid>

                        <!-- Word display / entry -->
                        <Grid x:Name="wordDisplayGrid">
                            <!-- Masked word display (shown when random) -->
                            <Border x:Name="maskedWordBorder"
                                    Stroke="{StaticResource Gray200}" StrokeThickness="1"
                                    BackgroundColor="{StaticResource White}" Padding="14,12"
                                    HorizontalOptions="Fill">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMaskedWordTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                    <Label x:Name="lblMaskedWord"
                                           Text="● ● ● ● ●"
                                           FontSize="22" CharacterSpacing="4"
                                           TextColor="{StaticResource Gray300}"
                                           HorizontalTextAlignment="Center"
                                           VerticalOptions="Center" />
                                    <Label Text="👁" FontSize="16" VerticalOptions="Center"
                                           TextColor="{StaticResource Gray400}" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Text entry (shown when custom or peeking) -->
                            <Border x:Name="entryBorder"
                                    Stroke="{StaticResource Primary}" StrokeThickness="1.5"
                                    BackgroundColor="{StaticResource White}" Padding="6,2"
                                    HorizontalOptions="Fill" IsVisible="False">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry x:Name="entryWord"
                                       Placeholder="Enter a word..."
                                       FontSize="18"
                                       HorizontalTextAlignment="Center"
                                       TextTransform="Uppercase"
                                       CharacterSpacing="4"
                                       MaxLength="8"
                                       Keyboard="Text"
                                       TextChanged="OnWordTextChanged"
                                       Unfocused="OnWordEntryUnfocused" />
                            </Border>
                        </Grid>

                        <Label x:Name="lblWordHint"
                               Text="Tap to peek at the word"
                               FontSize="12" TextColor="{StaticResource Gray400}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Word Length (shown when random) -->
                <Border x:Name="wordLengthCard"
                        Stroke="{StaticResource Gray100}" StrokeThickness="1"
                        BackgroundColor="#FAFAFA" Padding="20,18"
                        HorizontalOptions="Fill" Margin="0,0,0,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Word Length"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource Gray900}" VerticalOptions="Center" />
                            <Label x:Name="lblWordLengthValue" Grid.Column="1"
                                   Text="5 letters" FontSize="15"
                                   TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                        <Slider x:Name="wordLengthSlider"
                                Minimum="3" Maximum="7" Value="5"
                                MinimumTrackColor="{StaticResource Primary}"
                                MaximumTrackColor="{StaticResource Gray200}"
                                ThumbColor="{StaticResource Primary}"
                                ValueChanged="OnWordLengthChanged" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Begin Button -->
        <Button Grid.Row="1" x:Name="btnNext"
                Text="BEGIN"
                FontSize="18" FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="{StaticResource Tertiary}"
                CornerRadius="14"
                HeightRequest="56"
                MaximumWidthRequest="420"
                HorizontalOptions="Fill"
                Margin="0,20,0,10"
                Clicked="OnNextClicked" />
    </Grid>

</ContentPage>
